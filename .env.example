# OpenAI-Compatible API Configuration
OPENAI_API_KEY=sk-your-openai-or-vllm-proxy-key-here
OPENAI_BASE_URL=http://localhost:8000/v1

# Model Selection (Non-negotiable defaults)
LLM_MODEL=gemma-4-E4B-it
EMBEDDING_MODEL=bge-m3

# Retrieval & Agent Guardrails
MIN_SCORE=0.35
TOP_K=5
MAX_AGENT_STEPS=6
CHUNKING_STRATEGY=markdown_section

# Storage Paths
CORPUS_DIR=corpus
RAW_FILINGS_DIR=corpus/raw_filings
SQLITE_DB_PATH=corpus/financials.db
VECTOR_INDEX_PATH=corpus/vector_index.json

# Server Configuration
HOST=0.0.0.0
PORT=8080
